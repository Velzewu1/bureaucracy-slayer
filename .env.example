# Required. Create .env at the repository root and supply a real local value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=16000
COLLECTOR_TEST_URL=http://127.0.0.1:5180/dashboard
LIVE_EXTRACTION_MODE=goal_scoped

# Optional. Use only when the API key is scoped through a specific workspace.
ANTHROPIC_WORKSPACE_ID=

# Optional. Saves sanitized output under artifacts/; never stores credentials.
LIVE_EXTRACTION_SAVE_DEBUG=false

# Optional. When debug saving is enabled, select a new .json path under artifacts/.
# The command fails rather than overwriting an existing file. If omitted, the legacy
# artifacts/live-extraction-debug.json path is used with the same no-overwrite guarantee.
LIVE_EXTRACTION_DEBUG_PATH=
